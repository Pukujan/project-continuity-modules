{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/project-continuity-modules/blob/main/schemas/v1/decision-precondition.schema.json",
  "title": "PCM task decision precondition (live issue revision)",
  "description": "Explicit expected live GitHub issue revision. A CURRENT result only proves matching revision, not semantic truth or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "issue_number",
    "task_id",
    "expected_issue_state",
    "expected_issue_updated_at"
  ],
  "properties": {
    "schema": {
      "const": "pcm.decision-precondition.v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$"
    },
    "expected_issue_state": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "expected_issue_updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decision_comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{2,128}$"
    },
    "decision_body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "dependentRequired": {
    "decision_comment_id": [
      "decision_id",
      "decision_body_sha256"
    ],
    "decision_id": [
      "decision_comment_id",
      "decision_body_sha256"
    ],
    "decision_body_sha256": [
      "decision_comment_id",
      "decision_id"
    ]
  }
}
